# EduAgents FastAPI Backend Configuration

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
STORAGE_BUCKET_NAME=submissions

# Internal Cron Security (Shared secret for POST /internal/process-jobs)
INTERNAL_CRON_SECRET=super-secret-cron-token-123

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_FLASH=gemini-2.5-flash

# Runner & Processing Settings
PORT=8000
ENVIRONMENT=development
BATCH_LIMIT=10
GEMINI_CALL_DELAY_MS=1000

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:3000
